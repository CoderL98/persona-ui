{
  "name": "@persona-ui/theme-apple",
  "version": "0.1.3-beta",
  "description": "Apple HIG theme for Persona UI — human interface guidelines, control accent, material transparency",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./apple.css": "./dist/apple.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-theme-css.mjs theme-apple && node ../../scripts/inject-tokens-shim.mjs apple",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@persona-ui/lib": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "keywords": [
    "persona-ui",
    "theme",
    "apple-hig",
    "ios",
    "design-system"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoderL98/persona-ui.git",
    "directory": "packages/theme-apple"
  },
  "bugs": {
    "url": "https://github.com/CoderL98/persona-ui/issues"
  },
  "homepage": "https://github.com/CoderL98/persona-ui/tree/main/packages/theme-apple#readme"
}
