{
  "name": "@persona-ui/lib",
  "version": "0.1.4-beta",
  "description": "Svelte 5 dual-personality component library — Apple HIG & Material 3",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "svelte": "./dist/components/*/index.js",
      "default": "./dist/components/*/index.js"
    },
    "./styles.css": "./dist/styles/index.css",
    "./core.css": "./dist/styles/core.css",
    "./tokens-manifest": "./dist/tokens-manifest.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "svelte-package && node ./scripts/build-tokens-manifest.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@testing-library/svelte": "^5.3.1",
    "jsdom": "^29.1.1",
    "svelte": "^5.55.9",
    "svelte-check": "^4.4.8",
    "typescript": "^5.8.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "component-library",
    "design-system",
    "apple-hig",
    "material-design",
    "dual-theme"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoderL98/persona-ui.git",
    "directory": "packages/lib"
  },
  "bugs": {
    "url": "https://github.com/CoderL98/persona-ui/issues"
  },
  "homepage": "https://github.com/CoderL98/persona-ui/tree/main/packages/lib#readme"
}
