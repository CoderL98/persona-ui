{
  "name": "@persona-ui/theme-material",
  "version": "0.1.3-beta",
  "description": "Material 3 theme for Persona UI — Material You tokens, elevation, state layer, dynamic color",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./material.css": "./dist/material.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-theme-css.mjs theme-material && node ../../scripts/inject-tokens-shim.mjs material",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@persona-ui/lib": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "keywords": [
    "persona-ui",
    "theme",
    "material-3",
    "material-you",
    "design-system"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoderL98/persona-ui.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/CoderL98/persona-ui/issues"
  },
  "homepage": "https://github.com/CoderL98/persona-ui/tree/main/packages/theme-material#readme"
}
