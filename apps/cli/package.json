{
  "name": "@persona-ui/cli",
  "version": "0.1.2",
  "description": "Persona UI CLI — install themes from the central registry (federated shadcn-svelte model)",
  "license": "MIT",
  "private": false,
  "type": "module",
  "bin": {
    "pui-cli": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/inject-shebang.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "zod": "^3.23.0",
    "picocolors": "^1.0.0",
    "node-fetch-native": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "persona-ui",
    "cli",
    "theme",
    "registry",
    "shadcn",
    "federated"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcc/persona-ui.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/rcc/persona-ui/issues"
  },
  "homepage": "https://github.com/rcc/persona-ui/tree/main/apps/cli#readme"
}
