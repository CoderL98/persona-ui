{
  "name": "persona-ui",
  "version": "0.1.3-beta",
  "private": true,
  "description": "Persona UI monorepo — Svelte 5 dual-personality component library (Apple HIG & Material 3)",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @persona-ui/docs dev",
    "build": "pnpm run build:lib && pnpm run build:themes && pnpm run build:docs",
    "build:lib": "pnpm --filter @persona-ui/lib build",
    "build:themes": "pnpm --filter @persona-ui/theme-apple build && pnpm --filter @persona-ui/theme-material build",
    "build:theme-apple": "pnpm --filter @persona-ui/theme-apple build",
    "build:theme-material": "pnpm --filter @persona-ui/theme-material build",
    "build:docs": "pnpm --filter @persona-ui/docs build",
    "check": "pnpm --filter @persona-ui/lib check && pnpm --filter @persona-ui/theme-apple check && pnpm --filter @persona-ui/theme-material check && pnpm --filter @persona-ui/docs check",
    "test:unit": "pnpm --filter @persona-ui/lib test:unit",
    "test:a11y": "pnpm --filter @persona-ui/docs test:a11y",
    "test:visual": "pnpm --filter @persona-ui/docs test:visual",
    "test:css": "pnpm --filter @persona-ui/docs test:css",
    "test": "pnpm run check && pnpm run test:unit",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm -r publish --access public",
    "release": "pnpm run changeset:version && pnpm run build:lib && pnpm run build:themes && pnpm run changeset:publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.0.1",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "component-library",
    "design-system",
    "apple-hig",
    "material-design",
    "dual-theme",
    "monorepo"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.5.1"
}
